# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/
/playwright-report/
/test-results/
/blob-report/
/tmp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.preview-logs/

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify
/graphify-out/

# Product imagery is uploaded to Sanity and kept out of GitHub
/public/images/product-backgrounds/
/public/images/silver-idols/**/*.png
/public/images/silver-idols/**/*.jpg
/public/images/silver-idols/**/*.jpeg
/public/images/silver-idols/**/*.webp
