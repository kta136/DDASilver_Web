# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/
/playwright-report/
/test-results/
/blob-report/
/tmp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
.codex-tmp/
*.pem
*.traineddata
__pycache__/
*.py[cod]

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.preview-logs/

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify
/graphify-out/

# Product gallery imagery is uploaded to Sanity and kept out of GitHub.
# Keep manifests, review CSVs, audit notes, and ingestion scripts tracked.
/public/images/product-backgrounds/
/public/images/gallery-ingestion/**/*.png
/public/images/gallery-ingestion/**/*.jpg
/public/images/gallery-ingestion/**/*.jpeg
/public/images/gallery-ingestion/**/*.webp
/public/images/gallery-ingestion/**/*.avif
/public/images/gallery-ingestion/**/*.gif
/public/images/gallery-ingestion/**/*.tif
/public/images/gallery-ingestion/**/*.tiff
/public/images/gallery-ingestion/**/*.bmp
/public/images/silver-*/**/*.png
/public/images/silver-*/**/*.jpg
/public/images/silver-*/**/*.jpeg
/public/images/silver-*/**/*.webp
/public/images/silver-*/**/*.avif
/public/images/silver-*/**/*.gif
/public/images/silver-*/**/*.tif
/public/images/silver-*/**/*.tiff
/public/images/silver-*/**/*.bmp
/docs/product-gallery-approvals/**/*.png
/docs/product-gallery-approvals/**/*.jpg
/docs/product-gallery-approvals/**/*.jpeg
/docs/product-gallery-approvals/**/*.webp
/docs/product-gallery-approvals/**/*.avif
